{
  "name": "yandex-games",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "games/*",
    "tools"
  ],
  "scripts": {
    "dev:anomaly": "node tools/dev.mjs anomaly",
    "dev:flea": "node tools/dev.mjs flea",
    "proxy:anomaly": "node tools/proxy.mjs anomaly",
    "proxy:flea": "node tools/proxy.mjs flea",
    "build:anomaly": "vite build --config games/anomaly/vite.config.ts",
    "build:flea": "vite build --config games/flea/vite.config.ts",
    "zip:anomaly": "node tools/build-zip.mjs anomaly",
    "zip:flea": "node tools/build-zip.mjs flea",
    "check:anomaly": "node tools/check-release.mjs anomaly",
    "check:flea": "node tools/check-release.mjs flea",
    "test": "vitest run",
    "e2e:anomaly": "playwright test -c games/anomaly/playwright.config.ts",
    "e2e:flea": "playwright test -c games/flea/playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ysdk": "^1.2.0",
    "@yandex-games/sdk-dev-proxy": "^0.0.2",
    "adm-zip": "^0.6.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "~7.3.7",
    "vitest": "^5.0.4",
    "winston": "^3.19.0"
  }
}
